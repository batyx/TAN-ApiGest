meta {
  name: 04 - Modifier le nom d'un arrêt
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/{{codeLieu}}/arret
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "libelle": "{{libelle}}"
  }
}

vars:pre-request {
  codeLieu: COMM
  libelle: Commerce (test)
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("La réponse est l'arrêt avec son nouveau nom", function () {
    expect(res.getBody().codeLieu).to.equal("COMM");
    expect(res.getBody().libelle).to.equal("Commerce (test)");
  });
}

docs {
  # PUT /{codeLieu}/arret
  
  Modifie l'arrêt `codeLieu`. Utilisée par la fonctionnalité F4, qui n'envoie
  que le nom : `{ "libelle": "Nouveau nom" }`. L'API accepte aussi `codeLieu`
  dans le corps pour changer le code (non utilisé par l'application).
  
  Réponses (V2) :
  - 200 + l'arrêt modifié ;
  - 404 si l'arrêt est introuvable ;
  - 409 si le nouveau code est déjà celui d'un autre arrêt ;
  - 422 si le corps est vide ou si une valeur envoyée est vide.
  
  Ensuite, « 02 - Reset des données » rétablit les données.
}
