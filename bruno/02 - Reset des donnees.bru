meta {
  name: 02 - Reset des données
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/reset
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("La réponse est la liste réinitialisée", function () {
    expect(res.getBody()).to.be.an("array").that.is.not.empty;
  });
}

docs {
  # GET /reset
  
  Remet les données de cette copie de l'API dans leur état initial.
  Utilisée par le bouton « Réinitialiser » de l'écran Arrêts.
  
  Réponse (V2) : 200 + la liste des arrêts réinitialisée, au même format que
  « 01 - Liste des arrêts ». L'application l'affiche directement.
}
