meta {
  name: 03 - Ajout d'une ligne à un arrêt
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/{{codeLieu}}/arret
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "numLigne": "{{numLigne}}"
  }
}

vars:pre-request {
  codeLieu: COMM
  numLigne: TEST
}

tests {
  test("Statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("La ligne est ajoutée (l'API répond true)", function () {
    expect(res.getBody()).to.equal(true);
  });
}

docs {
  # POST /{codeLieu}/arret
  
  Ajoute la ligne `numLigne` à l'arrêt `codeLieu`, si elle n'y figure pas déjà.
  Utilisée par la fonctionnalité F3 de l'application.
  
  Corps JSON envoyé par l'application : `{ "numLigne": "C6" }`.
  
  Réponse : toujours statut 200, avec `true` si la ligne a été ajoutée, `false` si
  l'arrêt est introuvable ou si la ligne y figure déjà. Relancer la requête une
  seconde fois doit donc donner `false` (le second test échoue, c'est attendu).
  
  Vérification : relancer « 01 - Liste des arrêts » et chercher l'arrêt COMM,
  la ligne TEST doit apparaître dans son tableau `ligne`.
  Ensuite, « 02 - Reset des données » remet les données dans leur état initial.
}
