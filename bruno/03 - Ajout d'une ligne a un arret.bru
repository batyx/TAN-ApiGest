meta {
  name: 03 - Ajout d'une ligne à un arrêt
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/{{codeLieu}}/arret
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "numLigne": "{{numLigne}}"
  }
}

vars:pre-request {
  codeLieu: COMM
  numLigne: TEST
}

tests {
  test("Statut 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("La réponse est la ligne ajoutée", function () {
    expect(res.getBody().numLigne).to.equal("TEST");
  });
}

docs {
  # POST /{codeLieu}/arret
  
  Ajoute la ligne `numLigne` à l'arrêt `codeLieu`. Utilisée par la fonctionnalité F3.
  Corps JSON : `{ "numLigne": "C6" }`.
  
  Réponses (V2) :
  - 201 + la ligne ajoutée : `{ "numLigne": "TEST" }` ;
  - 409 si la ligne dessert déjà l'arrêt : relancer la requête une seconde fois
    donne donc 409 (les tests échouent, c'est attendu) ;
  - 404 si l'arrêt est introuvable ;
  - 422 si `numLigne` est absent ou vide.
  
  Les erreurs ont un corps `{ "message": "..." }`.
  Ensuite, « 02 - Reset des données » remet les données dans leur état initial.
}
