<UserControl
    x:Class="TanApiGest.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <materialDesign:Card
        MaxWidth="640"
        Margin="32"
        Padding="32"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <StackPanel>
            <materialDesign:PackIcon
                Width="64"
                Height="64"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Kind="BusStop" />

            <TextBlock
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="26"
                Text="{Binding AppName, StringFormat='Bienvenue sur {0}'}" />

            <TextBlock
                Margin="0,16,0,0"
                FontSize="15"
                TextAlignment="Center"
                TextWrapping="Wrap">
                Maquette de l'outil d'édition des données du réseau TAN (arrêts, lignes, horaires…),
                alimentée par la plateforme de données publiques de Nantes Métropole.
            </TextBlock>

            <TextBlock
                Margin="0,16,0,0"
                FontSize="15"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="Ouvrez le menu (☰) pour accéder aux fonctionnalités." />

            <TextBlock
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Opacity="0.7"
                Text="{Binding ApiUrl, StringFormat='API interrogée : {0}'}" />
        </StackPanel>
    </materialDesign:Card>
</UserControl>
