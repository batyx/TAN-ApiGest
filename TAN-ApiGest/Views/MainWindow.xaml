<Window
    x:Class="TanApiGest.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localComponents="clr-namespace:TanApiGest.Views.Components"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TAN-ApiGest - Gestion des données du réseau TAN"
    Width="1100"
    Height="700"
    MinWidth="800"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--  Coque Material Design : menu latéral rétractable + zone de contenu navigable.  -->
    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding IsMenuOpen, Mode=TwoWay}">

        <materialDesign:DrawerHost.LeftDrawerContent>
            <DockPanel MinWidth="220">
                <ToggleButton
                    Margin="16"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Top"
                    IsChecked="{Binding IsMenuOpen, Mode=TwoWay}"
                    Style="{StaticResource MaterialDesignHamburgerToggleButton}" />

                <ListBox ItemsSource="{Binding MainMenuItems}" SelectedItem="{Binding SelectedMenuItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--  Le DataTemplate lit Label/IconType et les transmet au composant graphique.  -->
                            <localComponents:IconAndTextMenuItem IconKind="{Binding IconType}" Label="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <DockPanel>
            <materialDesign:ColorZone
                Padding="16"
                materialDesign:ElevationAssist.Elevation="Dp4"
                DockPanel.Dock="Top"
                Mode="PrimaryMid">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton
                        Grid.Column="0"
                        IsChecked="{Binding IsMenuOpen, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignHamburgerToggleButton}" />

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Tram" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="22"
                            Text="{Binding Title}" />
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>

            <!--
                Snackbar global, en bas de la fenêtre. Sa MessageQueue est celle
                de SnackbarService ; elle transite par le ViewModel comme toute
                autre donnée affichée.
            -->
            <materialDesign:Snackbar
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="{Binding SnackbarBorderBrush}"
                BorderThickness="0,2,0,0"
                DockPanel.Dock="Bottom"
                MessageQueue="{Binding MessageQueue}" />

            <!--  Vue courante, résolue par MainWindowNavigationService via le conteneur DI.  -->
            <ContentControl Content="{Binding CurrentView}" />
        </DockPanel>
    </materialDesign:DrawerHost>
</Window>
